<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SearcherWindow</class>
 <widget class="QMainWindow" name="SearcherWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>800</width><height>600</height></rect>
  </property>
  <property name="windowTitle">
   <string>Поисковая система</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayout">
    <item>
     <widget class="QTabWidget" name="tabWidget">
      <widget class="QWidget" name="searchTab">
       <attribute name="title"><string>Поиск</string></attribute>
       <layout class="QVBoxLayout" name="verticalLayout_2">
        <item>
         <layout class="QHBoxLayout" name="horizontalLayout">
          <item>
           <widget class="QLineEdit" name="searchLineEdit">
            <property name="placeholderText"><string>Введите запрос (до 4 слов)</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="searchButton">
            <property name="text"><string>Искать</string></property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QTextEdit" name="resultsTextEdit">
          <property name="readOnly"><bool>true</bool></property>
         </widget>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="wordsTab">
       <attribute name="title"><string>Слова в базе данных</string></attribute>
       <layout class="QVBoxLayout" name="verticalLayout_3">
        <item>
         <widget class="QTableWidget" name="wordsTable"/>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="relevanceTab">
       <attribute name="title"><string>Результаты запроса</string></attribute>
       <layout class="QVBoxLayout" name="verticalLayout_4">
        <item>
         <widget class="QPushButton" name="showRelevanceButton">
          <property name="text"><string>Показать найденные документы и релевантность</string></property>
          <property name="enabled"><bool>false</bool></property>
         </widget>
        </item>
        <item>
         <widget class="QTableWidget" name="relevanceTable"/>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
 </widget>
